{
  "private": true,
  "name": "browser-app",
  "version": "0.0.0",
  "dependencies": {
    "@theia/core": "1.65.2",
    "@theia/editor": "1.65.2",
    "@theia/filesystem": "1.65.2",
    "@theia/markers": "1.65.2",
    "@theia/messages": "1.65.2",
    "@theia/monaco": "1.65.2",
    "@theia/navigator": "1.65.2",
    "@theia/preferences": "1.65.2",
    "@theia/process": "1.65.2",
    "@theia/terminal": "1.65.2",
    "@theia/workspace": "1.65.2",
    "@theia/property-view": "1.65.2",
    "react-grab-helper": "0.0.0",
    "app-state": "0.0.1"
  },
  "devDependencies": {
    "@theia/cli": "1.65.2",
    "react-grab": "^0.0.53"
  },
  "scripts": {
    "bundle": "yarn run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
