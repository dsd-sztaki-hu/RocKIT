          "multiple": false
        },
        {
          "id": "https://dataverse.org/schema/citation/authorAffiliation",
          "name": "authorAffiliation",
          "label": "Affiliation",
          "type": ["Text"],
          "required": false,
          "multiple": false
        }
      ]
    }
  }
