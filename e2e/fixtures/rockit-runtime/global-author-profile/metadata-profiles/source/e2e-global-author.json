{
  "metadata": {
    "name": "E2E Global Author",
    "version": "1.0.0",
    "description": "Local deterministic author profile used only by Electron E2E tests."
  },
  "classes": {
    "Dataset": {
      "inputs": [
        {
          "id": "http://purl.org/dc/terms/creator",
