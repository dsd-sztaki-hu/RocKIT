{
  "private": true,
  "name": "electron-app",
  "version": "1.0.9",
  "homepage": "https://repo.researchdata.hu/rockit/",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsd-sztaki-hu/RocKIT.git",
    "directory": "electron-app"
  },
  "author": {
    "name": "SZTAKI, Department of Distributed Systems",
    "url": "https://dsd.sztaki.hu"
  },
  "bugs": {
    "url": "https://github.com/dsd-sztaki-hu/RocKIT/issues",
    "email": "zoltan.toth@sztaki.hu"
  },
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Zoltan Toth",
      "email": "zoltan.toth@sztaki.hu",
      "url": "https://dsd.sztaki.hu"
    }
  ],
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/core": "1.65.2",
    "@theia/editor": "1.65.2",
    "@theia/electron": "1.65.2",
    "@theia/filesystem": "1.65.2",
    "@theia/markers": "1.65.2",
    "@theia/messages": "1.65.2",
    "@theia/monaco": "1.65.2",
    "@theia/plugin-ext-vscode": "1.65.2",
    "@theia/preferences": "1.65.2",
    "@theia/process": "1.65.2",
    "@theia/terminal": "1.65.2",
    "@theia/workspace": "1.65.2",
    "rockit-theia-overrides": "1.0.0",
    "agent-instructions": "1.0.0",
    "agent-launcher": "1.0.0",
    "app-state": "0.0.1",
    "rockit-common": "1.0.0",
    "rockit-loadmask": "1.0.0",
    "@arpproject/rocrate-mcp-server": "1.3.0",
    "data-repository-manager": "1.0.0",
    "data-sources": "1.0.0",
    "entities-overview": "1.0.0",
    "package-ro-crate": "1.0.0",
    "@theia/navigator": "1.65.2",
    "file-preview": "1.0.0",
    "metadata-profile-manager": "1.0.0",
    "open-editors": "1.0.0",
    "property-selector": "1.0.0",
    "react-grab-helper": "1.0.0",
    "remote-ro-crate-conversion": "1.0.0",
    "ro-crate-editor": "1.0.0",
    "ro-crate-preview": "1.0.0",
    "ro-crate-structure-panel": "1.0.0",
    "save-ro-crate": "1.0.0",
    "schema-validator": "1.0.0",
    "multi-edit": "1.0.0",
    "global-entity-library": "1.0.0"
  },
  "devDependencies": {
    "@arpproject/recrate": "0.1.59",
    "@theia/cli": "1.65.2",
    "allotment": "^1.20.5",
    "electron": "37.2.1"
  },
  "scripts": {
    "bundle": "yarn run stage:rocrate-mcp-standalone && yarn run rebuild && theia build --mode development && yarn run copy:node-pty-agent",
    "copy:node-pty-agent": "node ../scripts/copy-node-pty-agent.js",
    "fetch:darwin-native": "node ../scripts/fetch-darwin-native.js",
    "stage:rocrate-mcp-standalone": "yarn workspace @arpproject/rocrate-mcp-server build:standalone",
    "dist:mac:arm64": "yarn run fetch:darwin-native arm64 && electron-builder --mac dmg --arm64",
    "dist:mac:x64": "yarn run fetch:darwin-native x64 && electron-builder --mac dmg --x64",
    "dist:mac": "yarn run dist:mac:x64 && yarn run dist:mac:arm64",
    "rebuild": "node ../scripts/ensure-electron-runtime.js && theia rebuild:electron --cacheRoot ..",
    "prestart": "node ../scripts/ensure-electron-runtime.js",
    "start": "theia start",
    "watch": "yarn run rebuild && WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 theia build --watch --mode development"
  },
  "theia": {
    "target": "electron",
    "backend": {
      "config": {
        "singleInstance": true
      }
    },
    "frontend": {
      "config": {
        "applicationName": "RocKIT",
        "uriScheme": "rockit",
        "electron": {
          "uriScheme": "rockit"
        }
      }
    }
  },
  "build": {
    "appId": "hu.sztaki.dsd.rockit",
    "productName": "RocKIT - RO-Crate Kit",
    "extraResources": [
      {
        "from": "../LICENSE.md",
        "to": "LICENSE.md"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "../plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../theia-extensions/rocrate-mcp-server/dist/npm",
        "to": "rocrate-mcp-server"
      }
    ],
    "asarUnpack": [
      "node_modules/@arpproject/rocrate-mcp-server/**",
      "node_modules/rockit-common/**",
      "node_modules/rocrate-context-core/**",
      "node_modules/cedar-template-converter/**",
      "node_modules/metadata-profile-core/**",
      "node_modules/@modelcontextprotocol/sdk/**",
      "lib/build/Release/**"
    ],
    "win": {
      "icon": "../resources/icon.ico"
    },
    "mac": {
      "icon": "../resources/icon.icns"
    },
    "linux": {
      "icon": "../resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "SZTAKI, DSD <zoltan.toth@sztaki.hu>"
    }
  }
}
