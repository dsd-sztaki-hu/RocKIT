{
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build:file-preview": "yarn workspace file-preview build",
    "build:metadata-schema-manager": "yarn workspace metadata-schema-manager build",
    "build:browser": "yarn run build:file-preview && yarn run build:metadata-schema-manager && yarn workspace browser-app run bundle",
    "build:electron": "yarn run build:file-preview && yarn run build:metadata-schema-manager && yarn workspace electron-app run bundle",
    "prepare": "lerna run prepare",
    "postinstall": "theia check:theia-version",
    "start:browser": "yarn workspace browser-app start",
    "start:electron": "yarn workspace electron-app start",
    "watch:property-view": "yarn workspace @theia/property-view watch",
    "watch:electron": "lerna run --parallel watch --scope app-state --scope electron-app",
    "watch:browser": "lerna run --parallel watch --scope app-state --scope browser-app",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "lerna": "2.4.0",
    "@biomejs/biome": "2.3.2"
  },
  "workspaces": [
    "dev-packages/*",
    "theia-extensions/*",
    "browser-app",
    "electron-app"
  ],
  "dependencies": {
    "generator-theia-extension": "^0.1.47"
  }
}
