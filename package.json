{
  "private": true,
  "name": "rockit",
  "version": "1.0.9",
  "description": "RocKIT - RO-Crate Kit desktop and browser application.",
  "homepage": "https://repo.researchdata.hu/rockit/",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsd-sztaki-hu/RocKIT.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "SZTAKI, Department of Distributed Systems",
    "url": "https://dsd.sztaki.hu"
  },
  "bugs": {
    "url": "https://github.com/dsd-sztaki-hu/RocKIT/issues",
    "email": "zoltan.toth@sztaki.hu"
  },
  "keywords": [
    "ro-crate",
    "research-data",
    "metadata",
    "theia",
    "electron"
  ],
  "contributors": [
    {
      "name": "Balazs E. Pataki",
      "email": "balazs.pataki@sztaki.hu",
      "url": "https://orcid.org/0000-0003-3482-0325"
    },
    {
      "name": "Kadosa Nagy",
      "email": "nagykadosa@sztaki.hu"
    },
    {
      "name": "Reka Csontos",
      "email": "csontosreka@sztaki.hu"
    },
    {
      "name": "Roland Tanacsi",
      "email": "tanacsi.roland@sztaki.hu"
    },
    {
      "name": "Zoltan Toth",
      "email": "zoltan.toth@sztaki.hu",
      "url": "https://orcid.org/0000-0002-5688-9668"
    }
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build:extensions": "yarn run recrate:build && lerna run build --stream --sort --skip-nx-cache",
    "build:rocrate-tools": "yarn workspace rocrate-context-core build && yarn workspace cedar-template-converter build && yarn workspace metadata-profile-core build && yarn workspace rockit-common build && yarn workspace @arpproject/rocrate-mcp-server build",
    "build:rocrate-mcp-standalone": "yarn workspace rocrate-context-core build && yarn workspace cedar-template-converter build && yarn workspace metadata-profile-core build && yarn workspace rockit-common build && yarn workspace @arpproject/rocrate-mcp-server build:standalone",
    "pack:rocrate-mcp-standalone": "yarn build:rocrate-mcp-standalone && yarn workspace @arpproject/rocrate-mcp-server pack:standalone",
    "test:rocrate-tools": "yarn workspace rocrate-context-core test && yarn workspace rockit-common test && yarn workspace @arpproject/rocrate-mcp-server test",
    "verify:rocrate-tools": "yarn build:rocrate-tools && yarn test:rocrate-tools",
    "download:plugins": "theia download:plugins && node scripts/configure-viewer-plugins.js",
    "build:browser": "yarn run build:extensions && yarn run download:plugins && yarn workspace browser-app run bundle",
    "build:electron": "node scripts/build-electron.js",
    "build:electron:impl": "yarn run build:extensions && yarn run download:plugins && yarn workspace electron-app run bundle",
    "prepare": "lerna run prepare",
    "clean": "node scripts/clean-build.js",
    "rebuild:electron": "node scripts/build-electron.js --rebuild",
    "rebuild:browser": "yarn run clean && yarn && yarn run build:browser",
    "postinstall": "theia check:theia-version",
    "start:browser": "yarn run download:plugins && yarn workspace browser-app start --plugins=local-dir:../plugins",
    "start:electron": "yarn run download:plugins && node scripts/start-electron.js",
    "start:rocrate-mcp": "yarn workspace @arpproject/rocrate-mcp-server start",
    "watch:browser": "lerna run --parallel watch --ignore electron-app",
    "watch:electron": "lerna run --parallel watch --ignore browser-app",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "recrate:dev": "yarn workspace @arpproject/recrate start",
    "recrate:scope-css": "node theia-extensions/ro-crate-editor/scripts/generate-recrate-scoped-css.js",
    "recrate:build": "yarn workspace @arpproject/recrate build && yarn run recrate:scope-css",
    "recrate:test": "yarn workspace @arpproject/recrate test",
    "recrate:publish": "yarn workspace @arpproject/recrate build && (cd dev-packages/recrate && npm publish)"
  },
  "devDependencies": {
    "lerna": "2.4.0",
    "@biomejs/biome": "2.3.2",
    "electron-builder": "26.4.0"
  },
  "workspaces": [
    "dev-packages/*",
    "theia-extensions/*",
    "browser-app",
    "electron-app"
  ],
  "dependencies": {
    "generator-theia-extension": "0.1.44",
    "dotenv": "17.2.3"
  },
  "resolutions": {
    "@types/minimatch": "3.0.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.media-preview": "https://open-vsx.org/api/vscode/media-preview/1.95.3/file/vscode.media-preview-1.95.3.vsix",
    "tomoki1207.pdf": "https://open-vsx.org/api/tomoki1207/pdf/1.2.2/file/tomoki1207.pdf-1.2.2.vsix",
    "vscode.json": "https://open-vsx.org/api/vscode/json/1.95.3/file/vscode.json-1.95.3.vsix",
    "vscode.json-language-features": "https://open-vsx.org/api/vscode/json-language-features/1.95.3/file/vscode.json-language-features-1.95.3.vsix",
    "janisdd.vscode-edit-csv": "https://open-vsx.org/api/janisdd/vscode-edit-csv/0.11.9/file/janisdd.vscode-edit-csv-0.11.9.vsix"
  }
}
