{
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build:property-view": "yarn workspace @theia/property-view build",
    "build:browser": "yarn run build:property-view && yarn workspace browser-app run bundle",
    "build:electron": "yarn run build:property-view && yarn workspace electron-app run bundle",
    "prepare": "lerna run prepare",
    "postinstall": "theia check:theia-version",
    "start:browser": "yarn workspace browser-app start",
    "start:electron": "yarn workspace electron-app start",
    "watch:property-view": "yarn workspace @theia/property-view watch",
    "watch:browser": "lerna run --parallel watch --ignore=electron-app",
    "watch:electron": "lerna run --parallel watch --ignore=browser-app"
  },
  "devDependencies": {
    "lerna": "2.4.0"
  },
  "workspaces": [
    "dev-packages/*",
    "theia-extensions/*",
    "browser-app",
    "electron-app"
  ],
    "dependencies": {
    "generator-theia-extension": "^0.1.47"
  }
}