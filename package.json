{
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build:navigator": "yarn workspace @theia/navigator build",
    "build:browser": "yarn run build:navigator && yarn workspace browser-app run bundle",
    "build:electron": "yarn run build:navigator && yarn workspace electron-app run bundle",
    "prepare": "lerna run prepare",
    "postinstall": "theia check:theia-version",
    "start:browser": "yarn workspace browser-app start",
    "start:electron": "yarn workspace electron-app start",
    "watch:navigator": "yarn workspace @theia/navigator watch",
    "watch:browser": "lerna run --parallel watch --ignore=electron-app",
    "watch:electron": "lerna run --parallel watch --ignore=browser-app"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "lerna": "2.4.0"
  },
  "workspaces": [
    "dev-packages/*",
    "theia-extensions/*",
    "browser-app",
    "electron-app"
  ]
}
