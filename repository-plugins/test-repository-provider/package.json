{
  "name": "rockit-test-repository-provider",
  "displayName": "RocKIT Test Repository Provider",
  "description": "Development-only provider used to verify RocKIT repository plugin registration.",
  "version": "0.0.1",
  "publisher": "rockit",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rockit.testRepository.verifyRegistration",
        "title": "RocKIT: Verify Test Repository Provider"
      },
      {
        "command": "rockit.testRepository.verifyCreateRoundTrip",
        "title": "RocKIT: Test Repository Create Round-Trip"
      }
    ]
  }
}
