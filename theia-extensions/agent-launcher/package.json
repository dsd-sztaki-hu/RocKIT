{
  "name": "agent-launcher",
  "version": "0.0.0",
  "description": "AROMA coding agent launcher",
  "dependencies": {
    "@theia/core": "1.65.2",
    "@theia/filesystem": "1.65.2",
    "@theia/terminal": "1.65.2",
    "@theia/workspace": "1.65.2",
    "agent-instructions": "0.0.0",
    "app-state": "0.0.1",
    "file-explorer": "0.0.0",
    "markdown-it": "^12.3.2",
    "tslib": "^2.6.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "theiaExtensions": [
    {
      "frontendElectron": "lib/electron-browser/agent-launcher-module",
      "backend": "lib/node/agent-launcher-backend-module"
    }
  ],
  "keywords": [
    "theia-extension"
  ],
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "theiaext build && node scripts/copy-css.js",
    "postbuild": "rimraf tsconfig.tsbuildinfo",
    "clean": "theiaext clean",
    "compile": "theiaext compile && node scripts/copy-css.js",
    "lint": "theiaext lint",
    "test": "theiaext test",
    "watch": "node scripts/copy-css.js && tsc -b -w --preserveWatchOutput"
  },
  "devDependencies": {
    "@types/markdown-it": "^12.2.3",
    "@theia/ext-scripts": "1.65.2",
    "rimraf": "6.0.0"
  },
  "nyc": {
    "extends": "../../configs/nyc.json"
  }
}
