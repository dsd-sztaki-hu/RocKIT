  "schemaOrgReview": {
    "reviewedOn": "2026-11-05",
    "criteria": "Add only close semantic equivalents of Dataverse fields. Existing native candidates retain priority. No ARP-only or Hungarian fields participate in these decisions.",
    "excluded": [
      {
        "properties": [
          "dateCreated",
          "datePublished"
        ],
        "targets": [
          "productionDate",
          "distributionDate",
          "dateOfDeposit"
        ],
        "reason": "Dataset creation/publication is not necessarily data production, distribution or repository deposit."
      },
      {
        "properties": [
          "publisher",
          "producer"
        ],
        "targets": [
          "distributor",
          "producer"
        ],
        "reason": "Publication responsibility and media production do not establish the Dataverse roles of generating copies or managing finances/administration."
      },
      {
        "properties": [
          "identifier"
        ],
        "targets": [
          "otherId"
        ],
        "reason": "A generic identifier can be the primary identifier; Dataverse specifically requests another identifier and its agency."
      },
      {
        "properties": [
          "url"
        ],
        "targets": [
          "alternativeURL"
        ],
        "reason": "The primary URL is not necessarily another location providing access to the dataset."
      },
      {
        "properties": [
          "citation"
        ],
        "targets": [
          "publication"
        ],
        "reason": "A cited resource need not be a publication that uses the dataset."
      },
      {
        "properties": [
          "about"
        ],
        "targets": [
          "subject",
          "topicClassification"
        ],
        "reason": "An arbitrary Thing, person or place is not necessarily a disciplinary subject or a classification term in the target vocabulary."
      },
      {
        "properties": [
          "givenName",
          "familyName"
        ],
        "targets": [
          "authorName"
        ],
        "reason": "Name parts are not independently equivalent to the complete author name; no name order is inferred."
      },
      {
        "properties": [
          "locationCreated",
          "contentLocation"
