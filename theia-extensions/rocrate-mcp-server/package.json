{
  "name": "@arpproject/rocrate-mcp-server",
  "version": "1.0.5",
  "description": "ARP RO-Crate MCP Server exposing RO-Crate editing and profile-aware validation tools for use in ARP",
  "license": "Apache-2.0",
  "author": {
    "name": "SZTAKI, Department of Distributed Systems",
    "url": "https://dsd.sztaki.hu"
  },
  "files": [
    "lib",
    "src"
  ],
  "main": "lib/server.js",
  "types": "lib/server.d.ts",
  "bin": {
    "rocrate-mcp-server": "lib/server.js"
  },
  "scripts": {
    "build": "node scripts/generate-workflow-docs-bundle.js && tsc -b && shx mkdir -p lib/dashboard/static && shx cp -r src/dashboard/static/. lib/dashboard/static/",
    "build:standalone": "node scripts/generate-workflow-docs-bundle.js && node scripts/build-standalone.js",
    "pack:standalone": "npm pack ./dist/npm",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "watch": "node scripts/generate-workflow-docs-bundle.js && tsc -b -w",
    "start": "node lib/server.js",
    "test": "yarn build && node test/test-core.js && node test/test-cli.js && node test/test-installer.js && node test/test-mcp-server.js",
    "test:dashboard": "yarn build && node test/test-dashboard-collector.js && node test/test-dashboard-http.js",
    "test:socket": "yarn build && node test/test-socket-lifecycle.js",
    "test:standalone-package": "yarn build:standalone && node test/test-standalone-package.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "rimraf": "^5.0.0",
    "shx": "^0.3.3",
    "typescript": "~5.4.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "rockit-common": "1.0.0",
    "cedar-template-converter": "1.0.0",
    "metadata-profile-core": "1.0.0",
    "rocrate-context-core": "0.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "contributors": [
    {
      "name": "Balazs E. Pataki",
      "email": "pataki@sztaki.hu",
      "url": "https://dsd.sztaki.hu"
    },
    {
      "name": "Kadosa Nagy",
      "email": "nagykadosa@sztaki.hu",
      "url": "https://dsd.sztaki.hu"
    },
    {
      "name": "Reka Csontos",
      "email": "csontosreka@sztaki.hu"
    },
    {
      "name": "Zoltan Toth",
      "email": "zoltan.toth@sztaki.hu",
      "url": "https://dsd.sztaki.hu"
    }
  ]
}
