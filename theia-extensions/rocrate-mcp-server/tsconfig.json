{
  "compilerOptions": {
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noImplicitAny": true,
    "noEmitOnError": false,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2019",
    "lib": ["ES2019"],
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib",
    "types": ["node"]
  },
  "include": ["src"]
}
